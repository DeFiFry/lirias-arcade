# Node dependencies (regenerated by Launch-Arcade.bat / npm install)
frontend/node_modules/

# Local backup script - not part of the repo content itself
Lirias Arcade Backup.bat

# Game ROM files - folder structure is tracked, file contents are not.
# No ROMs are included in this repo. See INSTALL_GUIDE.pdf.
roms/*/*
!roms/*/.gitkeep

# Background music - folder is tracked, file contents are not (copyright).
# See INSTALL_GUIDE.pdf for how to add your own alice.mp3.
music/*
!music/.gitkeep

# Console BIOS dumps (PSX, Dreamcast dc_boot/dc_flash, ...) - copyrighted
# firmware, never in this repo. Any depth, so bios/dc/ is covered too. This
# also keeps out emulator state that lives beside them: Dreamcast VMU saves,
# dc_nvmem.bin (clock/settings) and dx11_shader_cache.bin.
/bios/**/*.bin
/bios/**/*.BIN

# N64 shader cache - per-GPU, rebuilt automatically on first play.
# bios/Mupen64plus/mupen64plus.ini (the core's public ROM catalog) stays tracked.
/bios/Mupen64plus/shaders/

# Windows shortcut with this machine's paths - Launch-Arcade.bat is the entry point.
/Liria's Arcade.lnk

# PS2 BIOS dumps + game compatibility DB for the LRPS2 (pcsx2_libretro) core.
# This core requires this exact subfolder layout - see README.
/bios/pcsx2/

# Dolphin's 'Sys' folder for the dolphin_libretro core (Wii/GameCube). ~2700
# redistributable emulator data files, not firmware and not repo content -
# RetroArch re-downloads them from buildbot.libretro.com/assets/system/Dolphin.zip.
/bios/dolphin-emu/

# Streets of Rage ROM-hack workspace (private mod tooling, patches, backups,
# music, notes). Nothing in here is repo content - see sor-mod/SOR-MOD-RULES.pdf.
/sor-mod/

# Personal frontend settings merged over frontend/config.json (may name ROM files).
frontend/config.local.json

# Generated arcade-cabinet overlays, measurements and temp screenshots
# (rebuilt automatically from frontend/assets/left-side.png + right-side.png).
frontend/assets/cabinet-cache/
